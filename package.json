{
    "name": "crossword-app",
    "version": "1.0.0",
    "description": "Private legacy continuity bridge for Crossword",
    "private": true,
    "workspaces": [
        "apps/web",
        "packages/application",
        "packages/construction",
        "packages/domain",
        "packages/model-runtime",
        "packages/persistence"
    ],
    "packageManager": "npm@11.19.0",
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "scripts": {
        "test": "jest",
        "build": "node scripts/build-legacy-assets.mjs",
        "legacy:assets": "node scripts/build-legacy-assets.mjs",
        "web:dev": "npm --workspace @crossword/web run dev --",
        "web:build": "npm --workspace @crossword/web run build",
        "web:test": "npm --workspace @crossword/web run test",
        "scan:content": "node scripts/scan-forbidden-content.mjs",
        "e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers playwright test --config apps/web/playwright.config.ts",
        "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers npx playwright install chromium",
        "test:mutation": "stryker run"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/vitest-runner": "^10.0.0",
        "axios": "1.13.2",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "socket.io-client": "4.8.3",
        "vue": "2.7.16"
    },
    "jest": {
        "testEnvironment": "jsdom",
        "verbose": true,
        "moduleDirectories": [
            "node_modules",
            "src/crossword/static"
        ],
        "testPathIgnorePatterns": [
            "/apps/",
            "/packages/"
        ]
    }
}
